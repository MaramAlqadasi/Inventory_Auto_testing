{
  "name": "inventory_auto_testing",
  "version": "1.0.0",
  "description": "Playwright E2E automation for Smart Life ERP — Inventory / Products List",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "auth": "playwright test --project=setup",
    "auth:headed": "playwright test --project=setup --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaramAlqadasi/Inventory_Auto_testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MaramAlqadasi/Inventory_Auto_testing/issues"
  },
  "homepage": "https://github.com/MaramAlqadasi/Inventory_Auto_testing#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3"
  }
}
