# قالب متغيّرات البيئة — انسخيه إلى .env واملئي القيم الحقيقية.
# ⛔ .env مُتجاهَل في git ولا يُودَع أبداً.

# رابط صفحة تسجيل الدخول الكامل (يُشتق منه baseURL تلقائياً في playwright.config.js)
BASE_URL=https://smarterp.top/login

# بيانات حساب الاختبار (دور owner) — نفس الأسماء تُضاف كـ GitHub Actions Secrets للتشغيل في CI
ERP_COMPANY=
ERP_USER=
ERP_PASSWORD=

# (اختياري) حساب بدور محدود لفتح مجموعة RBAC — اتركيها فارغة إن لم يتوفّر
ERP_LIMITED_COMPANY=
ERP_LIMITED_USER=
ERP_LIMITED_PASSWORD=
